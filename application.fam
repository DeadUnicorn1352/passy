# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="passy",  # Must be unique
    name="Passport Reader",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="passy_app",
    stack_size=3 * 1024,
    fap_category="NFC",
    # Optional values
    fap_version="1.5",
    fap_icon="passy.png",  # 10x10 1-bit PNG
    fap_description="eMRTD Reader",
    fap_author="bettse",
    fap_weburl="https://github.com/bettse/passy",
    fap_icon_assets="images",  # Image assets to compile for this application
    # fap_libs=["mbedtls"],
    sources=["*.c*", "!*.css"],
    cdefines=[
        "MBEDTLS_ECP_DP_BP256R1_ENABLED",
        "MBEDTLS_HMAC_DRBG_C", "MBEDTLS_ENTROPY_C", "MBEDTLS_PSA_CRYPTO_C", "MBEDTLS_NO_PLATFORM_ENTROPY"], # "lib/mbedtls/include/mbedtls/mbedtls_config.h", 
    fap_private_libs=[
        Lib(
            name="asn1",
            cflags=["-Wno-error", "-DASN_EMIT_DEBUG=0", "-Os", "-DASN_DISABLE_PER_SUPPORT=1"],
        ),
        Lib(
            name="mbedtls",
            fap_include_paths=["include"],
            # sources=[
            #     "aes.c",
            #     "bignum.c",
            #     "bignum_core.c",
            #     "ecdsa.c",
            #     "ecp.c",
            #     "ecp_curves.c",
            #     "md.c",
            #     "md5.c",
            #     "platform_util.c",
            #     "ripemd160.c",
            #     "sha1.c",
            #     "sha256.c",
            #     "des.c",
            #     "psa_util.c"
            # ],
            cflags=["-mword-relocations", "-Wno-error", "-mlong-calls", "-Wno-redundant-decls"],
        ),
    ],
)
